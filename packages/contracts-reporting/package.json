{
	"name": "@henko-software/contracts-reporting",
	"version": "0.1.1",
	"description": "Contrato del módulo reporting: rubros del estado de resultados (árbol con subtotales por fórmula), de dónde sale cada importe y el reporte de un mes.",
	"license": "UNLICENSED",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/Henko-Software/henko-contracts.git",
		"directory": "packages/contracts-reporting"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"henko-source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"@henko-software/contracts-catalog": "workspace:^",
		"@henko-software/contracts-common": "workspace:^",
		"@henko-software/contracts-purchasing": "workspace:^",
		"@henko-software/contracts-sales": "workspace:^",
		"zod": "^4.1.0"
	}
}
